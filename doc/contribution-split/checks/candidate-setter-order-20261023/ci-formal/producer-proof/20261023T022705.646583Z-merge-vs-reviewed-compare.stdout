":"https://api.github.com/users/x4w2nyhvk8/followers","following_url":"https://api.github.com/users/x4w2nyhvk8/following{/other_user}","gists_url":"https://api.github.com/users/x4w2nyhvk8/gists{/gist_id}","starred_url":"https://api.github.com/users/x4w2nyhvk8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/x4w2nyhvk8/subscriptions","organizations_url":"https://api.github.com/users/x4w2nyhvk8/orgs","repos_url":"https://api.github.com/users/x4w2nyhvk8/repos","events_url":"https://api.github.com/users/x4w2nyhvk8/events{/privacy}","received_events_url":"https://api.github.com/users/x4w2nyhvk8/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a45f6d6536cdd59c61257e994e98d742f9c242ff","url":"https://api.github.com/repos/osfans/trime/commits/a45f6d6536cdd59c61257e994e98d742f9c242ff","html_url":"https://github.com/osfans/trime/commit/a45f6d6536cdd59c61257e994e98d742f9c242ff"}]},{"sha":"daffad688221c959f60dea8526d3a5ac3919dbcd","node_id":"C_kwDOAivEQNoAKGRhZmZhZDY4ODIyMWM5NTlmNjBkZWE4NTI2ZDNhNWFjMzkxOWRiY2Q","commit":{"author":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-20T14:22:02Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T12:03:32Z"},"message":"test(keyboard): restore key name lookup after each spec\n\nKeyCode.androidKeyNameToCode is a process-wide test seam. Specs that\nreplace it with a stub previously left that stub installed for later\nclasses, so behaviour depended on test order. Expose the real lookup as\ndefaultAndroidKeyNameToCode and restore it in afterSpec in all three\nspecs that override the seam.","tree":{"sha":"134fd51c587548238df2aae0c17d98a7f5af9167","url":"https://api.github.com/repos/osfans/trime/git/trees/134fd51c587548238df2aae0c17d98a7f5af9167"},"url":"https://api.github.com/repos/osfans/trime/git/commits/daffad688221c959f60dea8526d3a5ac3919dbcd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/daffad688221c959f60dea8526d3a5ac3919dbcd","html_url":"https://github.com/osfans/trime/commit/daffad688221c959f60dea8526d3a5ac3919dbcd","comments_url":"https://api.github.com/repos/osfans/trime/commits/daffad688221c959f60dea8526d3a5ac3919dbcd/comments","author":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a39859c16da7be240e4951c8c327223fa27a72cc","url":"https://api.github.com/repos/osfans/trime/commits/a39859c16da7be240e4951c8c327223fa27a72cc","html_url":"https://github.com/osfans/trime/commit/a39859c16da7be240e4951c8c327223fa27a72cc"}]},{"sha":"a2450f9a0b862b03eefdf0781e75dae02b071a2d","node_id":"C_kwDOAivEQNoAKGEyNDUwZjlhMGI4NjJiMDNlZWZkZjA3ODFlNzVkYWUwMmIwNzFhMmQ","commit":{"author":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-20T14:22:02Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T12:03:32Z"},"message":"build: add a make target for checks\n\nExpose make check for unit tests plus lint. It runs through Gradle and\nneeds neither the NDK nor a native build, so contributors can verify\nchanges without assembling an APK.","tree":{"sha":"74642187727cd16d2adad97f14f08e9cbb49ff3a","url":"https://api.github.com/repos/osfans/trime/git/trees/74642187727cd16d2adad97f14f08e9cbb49ff3a"},"url":"https://api.github.com/repos/osfans/trime/git/commits/a2450f9a0b862b03eefdf0781e75dae02b071a2d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/a2450f9a0b862b03eefdf0781e75dae02b071a2d","html_url":"https://github.com/osfans/trime/commit/a2450f9a0b862b03eefdf0781e75dae02b071a2d","comments_url":"https://api.github.com/repos/osfans/trime/commits/a2450f9a0b862b03eefdf0781e75dae02b071a2d/comments","author":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"daffad688221c959f60dea8526d3a5ac3919dbcd","url":"https://api.github.com/repos/osfans/trime/commits/daffad688221c959f60dea8526d3a5ac3919dbcd","html_url":"https://github.com/osfans/trime/commit/daffad688221c959f60dea8526d3a5ac3919dbcd"}]},{"sha":"35353126ac2392f0322334a7f9805de42f29db03","node_id":"C_kwDOAivEQNoAKDM1MzUzMTI2YWMyMzkyZjAzMjIzMzRhN2Y5ODA1ZGU0MmYyOWRiMDM","commit":{"author":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-20T14:22:02Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T12:03:32Z"},"message":"fix(theme): avoid java.nio.file APIs on API < 26\n\nThemeLoader.isInside used File.toPath and Path.startsWith, which are\navailable only from API 26 while minSdk is 21. The runCatching wrapper\nturned the resulting NoSuchMethodError into false, so every include was\nrejected on Android 7.1 and older.\n\nCompare canonical path strings with a separator boundary instead, which\nkeeps the escape check while working on all supported versions.","tree":{"sha":"6c3fe5cbc94bedaad6bd301fdd3368adbab61597","url":"https://api.github.com/repos/osfans/trime/git/trees/6c3fe5cbc94bedaad6bd301fdd3368adbab61597"},"url":"https://api.github.com/repos/osfans/trime/git/commits/35353126ac2392f0322334a7f9805de42f29db03","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/35353126ac2392f0322334a7f9805de42f29db03","html_url":"https://github.com/osfans/trime/commit/35353126ac2392f0322334a7f9805de42f29db03","comments_url":"https://api.github.com/repos/osfans/trime/commits/35353126ac2392f0322334a7f9805de42f29db03/comments","author":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a2450f9a0b862b03eefdf0781e75dae02b071a2d","url":"https://api.github.com/repos/osfans/trime/commits/a2450f9a0b862b03eefdf0781e75dae02b071a2d","html_url":"https://github.com/osfans/trime/commit/a2450f9a0b862b03eefdf0781e75dae02b071a2d"}]},{"sha":"90d3844da77b71cb1f7f6c4ae433f2d98bead420","node_id":"C_kwDOAivEQNoAKDkwZDM4NDRkYTc3YjcxY2IxZjdmNmM0YWU0MzNmMmQ5OGJlYWQ0MjA","commit":{"author":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-20T14:22:02Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T12:03:32Z"},"message":"ci: gate builds on style, lint, and unit test checks\n\nAdd a reusable checks workflow that runs make style-lint and make check\non Ubuntu. All build jobs now depend on it, so style, lint, or unit-test\nfailures block pull request, commit, nightly, and release builds instead\nof only surfacing in the build matrix.\n\nCheckout submodules recursively because build logic queries git describe\nin librime and its nested opencc dependency while configuring the\nproject, so they are required even for style and unit test jobs.\n\nDefine CI_NAME in the reusable workflow because it does not inherit the\nenvironment variables of its caller, which left the builder name to be\nresolved from the git configuration.","tree":{"sha":"e03cd948cdc8e373438de9780d71b6c2af93bbbb","url":"https://api.github.com/repos/osfans/trime/git/trees/e03cd948cdc8e373438de9780d71b6c2af93bbbb"},"url":"https://api.github.com/repos/osfans/trime/git/commits/90d3844da77b71cb1f7f6c4ae433f2d98bead420","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/90d3844da77b71cb1f7f6c4ae433f2d98bead420","html_url":"https://github.com/osfans/trime/commit/90d3844da77b71cb1f7f6c4ae433f2d98bead420","comments_url":"https://api.github.com/repos/osfans/trime/commits/90d3844da77b71cb1f7f6c4ae433f2d98bead420/comments","author":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"35353126ac2392f0322334a7f9805de42f29db03","url":"https://api.github.com/repos/osfans/trime/commits/35353126ac2392f0322334a7f9805de42f29db03","html_url":"https://github.com/osfans/trime/commit/35353126ac2392f0322334a7f9805de42f29db03"}]},{"sha":"9093457fac2d6e5323657dd17b7edfcda06bd803","node_id":"C_kwDOAivEQNoAKDkwOTM0NTdmYWMyZDZlNTMyMzY1N2RkMTdiN2VkZmNkYTA2YmQ4MDM","commit":{"author":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-20T14:22:02Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T12:03:32Z"},"message":"fix(build): fall back to the default when a git command fails\n\nrunCmd declares a default value for commands that fail, but providers.exec\nthrows as soon as the process exits with a non-zero value, so the fallback\nwas never used and the build failed while resolving the version metadata.\n\nIgnore the exit value so that the default is applied instead. This fixes\nconfiguration on machines without a git user name, such as GitHub Actions\nrunners.","tree":{"sha":"4f597d4d89774c3966aba393c5640f5c69227ae4","url":"https://api.github.com/repos/osfans/trime/git/trees/4f597d4d89774c3966aba393c5640f5c69227ae4"},"url":"https://api.github.com/repos/osfans/trime/git/commits/9093457fac2d6e5323657dd17b7edfcda06bd803","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/9093457fac2d6e5323657dd17b7edfcda06bd803","html_url":"https://github.com/osfans/trime/commit/9093457fac2d6e5323657dd17b7edfcda06bd803","comments_url":"https://api.github.com/repos/osfans/trime/commits/9093457fac2d6e5323657dd17b7edfcda06bd803/comments","author":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"90d3844da77b71cb1f7f6c4ae433f2d98bead420","url":"https://api.github.com/repos/osfans/trime/commits/90d3844da77b71cb1f7f6c4ae433f2d98bead420","html_url":"https://github.com/osfans/trime/commit/90d3844da77b71cb1f7f6c4ae433f2d98bead420"}]},{"sha":"19b048494ffa55cae52d5385dfa6d0611461c27d","node_id":"C_kwDOAivEQNoAKDE5YjA0ODQ5NGZmYTU1Y2FlNTJkNTM4NWRmYTZkMDYxMTQ2MWMyN2Q","commit":{"author":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-20T23:19:55Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T12:03:32Z"},"message":"ci: remove redundant submodule fetch\n\nThe checkout step already initializes all submodules recursively, and\nthe JNI cache hash step runs Gradle before this one, so the submodules\nmust be present regardless of the cache result. Fetching them again on\na cache miss does no useful work.","tree":{"sha":"d3583c92ee1cafd3eda60e2187006c565a1c0066","url":"https://api.github.com/repos/osfans/trime/git/trees/d3583c92ee1cafd3eda60e2187006c565a1c0066"},"url":"https://api.github.com/repos/osfans/trime/git/commits/19b048494ffa55cae52d5385dfa6d0611461c27d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/19b048494ffa55cae52d5385dfa6d0611461c27d","html_url":"https://github.com/osfans/trime/commit/19b048494ffa55cae52d5385dfa6d0611461c27d","comments_url":"https://api.github.com/repos/osfans/trime/commits/19b048494ffa55cae52d5385dfa6d0611461c27d/comments","author":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.co