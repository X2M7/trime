ain%2Fres%2Fvalues-zh-rTW%2Fstrings.xml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -102,8 +102,6 @@\n     <string name=\"hook_shift_num\">點擊0-9時，忽略Shift的鎖定狀態</string>\n     <string name=\"hook_shift_symbol\">點擊符號鍵時，忽略Shift的鎖定狀態</string>\n     <string name=\"hook_shift_arrow\">點選方向鍵時，保持Shift的鎖定狀態</string>\n-    <string name=\"hook_shift_lock\">雙擊 Shift 鎖定大寫</string>\n-    <string name=\"hook_shift_lock_summary\">再次單擊 Shift 可解除大寫鎖定</string>\n     <string name=\"export\">匯出</string>\n     <string name=\"scroll_to_bottom\">跳到最後</string>\n     <string name=\"app_crash_message\">抱歉，但我們為您帶來了一些紀錄檔以供調查。</string>"},{"sha":"b22352a96e888251a699bd765b9647f20c37daec","filename":"app/src/main/res/values/strings.xml","status":"modified","additions":0,"deletions":2,"changes":2,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fres%2Fvalues%2Fstrings.xml","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fres%2Fvalues%2Fstrings.xml","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fres%2Fvalues%2Fstrings.xml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -102,8 +102,6 @@\n     <string name=\"hook_shift_num\">Ignore Shift locked for 0-9</string>\n     <string name=\"hook_shift_symbol\">Ignore Shift locked for Symbol keys</string>\n     <string name=\"hook_shift_arrow\">Keep Shift locked for Arrow keys</string>\n-    <string name=\"hook_shift_lock\">Double tap Shift to lock caps lock</string>\n-    <string name=\"hook_shift_lock_summary\">Tap Shift once again to release the caps lock</string>\n     <string name=\"exception_logcat_created\">Logcat process is already created</string>\n     <string name=\"app_crash\">Application crashed</string>\n     <string name=\"app_crash_message\">Sorry, but we bring you some logs to investigate.</string>"},{"sha":"759e8bc2cb66afe3c320103a33e059836d4588d9","filename":"app/src/test/java/com/osfans/trime/data/theme/KeyActionManagerTest.kt","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FKeyActionManagerTest.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FKeyActionManagerTest.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FKeyActionManagerTest.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -15,6 +15,7 @@ class KeyActionManagerTest :\n         // The Android key-name lookup is a platform call that throws when not\n         // mocked; the Rime key table is the path under test.\n         beforeTest { KeyCode.androidKeyNameToCode = { 0 } }\n+        afterSpec { KeyCode.androidKeyNameToCode = KeyCode.defaultAndroidKeyNameToCode }\n \n         fun diagnostics(vararg presets: Pair<String, PresetKey>) = ThemeDiagnostics.presetDiagnostics(mapOf(*presets))\n "},{"sha":"5530047921357ab70b4753b1b104631cdf077850","filename":"app/src/test/java/com/osfans/trime/data/theme/ThemeDiagnosticsTest.kt","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FThemeDiagnosticsTest.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FThemeDiagnosticsTest.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FThemeDiagnosticsTest.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -22,6 +22,7 @@ class ThemeDiagnosticsTest :\n         // The Android key-name lookup is a platform call that throws when not\n         // mocked; the bare letters used by the fixtures resolve without it.\n         beforeTest { KeyCode.androidKeyNameToCode = { 0 } }\n+        afterSpec { KeyCode.androidKeyNameToCode = KeyCode.defaultAndroidKeyNameToCode }\n \n         /** Hex-only color parser; enough to tell colors from typos. */\n         fun parseHex(value: String): Int? {"},{"sha":"e30d588fbcc6638db35beeed4dc596127240f685","filename":"app/src/test/java/com/osfans/trime/ime/broadcast/EnterKeyDisplayDelegateTest.kt","status":"added","additions":120,"deletions":0,"changes":120,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fbroadcast%2FEnterKeyDisplayDelegateTest.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fbroadcast%2FEnterKeyDisplayDelegateTest.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fbroadcast%2FEnterKeyDisplayDelegateTest.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,120 @@\n+/* SPDX-License-Identifier: GPL-3.0-or-later */\n+package com.osfans.trime.ime.broadcast\n+\n+import android.text.InputType\n+import android.view.inputmethod.EditorInfo\n+import com.osfans.trime.data.theme.Theme\n+import com.osfans.trime.data.theme.model.GeneralStyle\n+import io.kotest.core.spec.style.StringSpec\n+import io.kotest.matchers.shouldBe\n+import org.kodein.di.DI\n+import org.kodein.di.bindInstance\n+\n+private class EnterDisplayFixture(mode: Int = EnterKeyDisplayDelegate.Mode.ACTION_LABEL_PREFERRED.ordinal) {\n+    private val broadcaster = InputBroadcaster()\n+    private val theme = Theme(\n+        name = \"Enter label test\",\n+        style = GeneralStyle(\n+            enterLabelMode = mode,\n+            enterLabels = GeneralStyle.EnterLabel(\n+                go = \"Theme go\",\n+                done = \"Theme done\",\n+                next = \"Theme next\",\n+                pre = \"Theme previous\",\n+                search = \"Theme search\",\n+                send = \"Theme send\",\n+                default = \"Theme return\",\n+            ),\n+        ),\n+    )\n+    val delegate = EnterKeyDisplayDelegate(\n+        DI {\n+            bindInstance<InputBroadcaster> { broadcaster }\n+            bindInstance<Theme> { theme }\n+        },\n+    )\n+    val events = mutableListOf<Pair<String, String>>()\n+\n+    init {\n+        broadcaster.addReceiver(\n+            object : InputBroadcastReceiver {\n+                override fun onEnterKeyLabelUpdate(label: String) {\n+                    events.add(label to delegate.keyLabel)\n+                }\n+            },\n+        )\n+    }\n+\n+    fun update(\n+        imeOptions: Int,\n+        inputType: Int = InputType.TYPE_CLASS_TEXT,\n+        actionId: Int = EditorInfo.IME_ACTION_UNSPECIFIED,\n+        actionLabel: CharSequence? = null,\n+    ) {\n+        delegate.updateLabel(inputType, imeOptions, actionId, actionLabel)\n+    }\n+}\n+\n+class EnterKeyDisplayDelegateTest :\n+    StringSpec({\n+        \"the same delegate publishes Search then Send then a custom action after updating its label\" {\n+            val fixture = EnterDisplayFixture()\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH)\n+            fixture.update(EditorInfo.IME_ACTION_SEND)\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH, actionId = 42, actionLabel = \"Approve\")\n+            fixture.delegate.keyLabel shouldBe \"Approve\"\n+            fixture.events shouldBe listOf(\n+                \"Theme search\" to \"Theme search\",\n+                \"Theme send\" to \"Theme send\",\n+                \"Approve\" to \"Approve\",\n+            )\n+        }\n+\n+        \"changing editor metadata without changing visible text does not broadcast again\" {\n+            val fixture = EnterDisplayFixture()\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH)\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH or EditorInfo.IME_FLAG_NO_EXTRACT_UI)\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH, actionLabel = \"\")\n+            fixture.delegate.keyLabel shouldBe \"Theme search\"\n+            fixture.events shouldBe listOf(\"Theme search\" to \"Theme search\")\n+        }\n+\n+        \"NO_ENTER_ACTION and TYPE_NULL restore the theme default despite a custom label\" {\n+            val fixture = EnterDisplayFixture()\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH)\n+            fixture.update(\n+                EditorInfo.IME_ACTION_SEND or EditorInfo.IME_FLAG_NO_ENTER_ACTION,\n+                inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE,\n+                actionId = 42,\n+                actionLabel = \"Approve\",\n+            )\n+            fixture.delegate.keyLabel shouldBe \"Theme return\"\n+            fixture.update(\n+                EditorInfo.IME_ACTION_SEARCH,\n+                inputType = InputType.TYPE_NULL,\n+                actionId = 42,\n+                actionLabel = \"Approve\",\n+            )\n+            fixture.delegate.keyLabel shouldBe \"Theme return\"\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH)\n+            fixture.events shouldBe listOf(\n+                \"Theme search\" to \"Theme search\",\n+                \"Theme return\" to \"Theme return\",\n+                \"Theme search\" to \"Theme search\",\n+            )\n+        }\n+\n+        \"app-only mode falls back to the theme default for null and empty labels\" {\n+            val fixture = EnterDisplayFixture(EnterKeyDisplayDelegate.Mode.ACTION_LABEL_ONLY.ordinal)\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH)\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH, actionId = 42, actionLabel = \"Find\")\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH, actionLabel = null)\n+            fixture.update(EditorInfo.IME_ACTION_SEARCH, actionLabel = \"\")\n+            fixture.delegate.keyLabel shouldBe \"Theme return\"\n+            fixture.events shouldBe listOf(\n+                \"Theme return\" to \"Theme return\",\n+                \"Find\" to \"Find\",\n+                \"Theme return\" to \"Theme return\",\n+            )\n+        }\n+    })"},{"sha":"45071da33e4d98f48b99f8f0b54a62970f914cd8","filename":"app/src/test/java/com/osfans/trime/ime/core/EditorEnterActionTest.kt","status":"added","additions":136,"deletions":0,"changes":136,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FEditorEnterActionTest.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FEditorEnterActionTest.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FEditorEnterActionTest.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,136 @@\n+/* SPDX-License-Identifier: GPL-3.0-or-later */\n+package com.osfans.trime.ime.core\n+\n+import android.text.InputType\n+import android.view.inputmethod.EditorInfo\n+import io.kotest.core.spec.style.StringSpec\n+import io.kotest.matchers.shouldBe\n+\n+private val enterThemeLabels = mapOf(\n+    EditorInfo.IME_ACTION_GO to \"Theme go\",\n+    EditorInfo.IME_ACTION_SEARCH to \"Theme search\",\n+    EditorInfo.IME_ACTION_SEND to \"Theme send\",\n+    EditorInfo.IME_ACTION_NEXT to \"Theme next\",\n+    EditorInfo.IME_ACTION_DONE to \"Theme done\",\n+    EditorInfo.IME_ACTION_PREVIOUS to \"Theme previous\",\n+)\n+\n+private fun enterLabel(action: Int?, appLabel: CharSequence?, mode: Int): String = EditorEnterAction.label(action, appLabel, mode, \"Theme return\", enterThemeLabels::get)\n+\n+class EditorEnterActionTest :\n+    StringSpec({\n+        \"standard actions use their matching theme labels after unrelated option flags are masked\" {\n+            for ((id, expectedLabel) in enterThemeLabels) {\n+                val action = EditorEnterAction.resolve(\n+                    InputType.TYPE_CLASS_TEXT,\n+                    id or EditorInfo.IME_FLAG_NO_EXTRACT_UI or EditorInfo.IME_FLAG_NAVIGATE_NEXT,\n+                    EditorInfo.IME_ACTION_UNSPECIFIED,\n+                    null,\n+                )\n+                action shouldBe id\n+                enterLabel(action, null, 0) shouldBe expectedLabel\n+            }\n+        }\n+\n+        \"NONE and UNSPECIFIED send a Return key and show the default instead of an app label\" {\n+            for (id in listOf(EditorInfo.IME_ACTION_NONE, EditorInfo.IME_ACTION_UNSPECIFIED)) {\n+                val action = EditorEnterAction.resolve(InputType.TYPE_CLASS_TEXT, id, 0, \"App action\")\n+                action shouldBe null\n+                for (mode in 0..3) enterLabel(action, \"App action\", mode) shouldBe \"Theme return\"\n+            }\n+        }\n+\n+        \"a labeled nonstandard custom ID wins over the search option for both action and label\" {\n+            val action = EditorEnterAction.resolve(InputType.TYPE_CLASS_TEXT, EditorInfo.IME_ACTION_SEARCH, 42, \"Approve\")\n+            action shouldBe 42\n+            // Mode 0 must not misleadingly show Search for a custom action it cannot name.\n+            enterLabel(action, \"Approve\", 0) shouldBe \"Theme return\"\n+            for (mode in 1..3) enterLabel(action, \"Approve\", mode) shouldBe \"Approve\"\n+        }\n+\n+        \"a custom ID in the standard action set uses that action's theme label\" {\n+            val action = EditorEnterAction.resolve(\n+                InputType.TYPE_CLASS_TEXT,\n+                EditorInfo.IME_ACTION_SEARCH,\n+                EditorInfo.IME_ACTION_SEND,\n+                \"App delivery\",\n+            )\n+            action shouldBe EditorInfo.IME_ACTION_SEND\n+            enterLabel(action, \"App delivery\", 0) shouldBe \"Theme send\"\n+            enterLabel(action, \"App delivery\", 1) shouldBe \"App delivery\"\n+            enterLabel(action, \"App delivery\", 2) shouldBe \"App delivery\"\n+            enterLabel(action, \"App delivery\", 3) shouldBe \"Theme send\"\n+        }\n+\n+        \"a missing custom label does not make actionId override the standard option\" {\n+            for (label in listOf(null, \"\")) {\n+                val action = EditorEnterAction.resolve(InputType.TYPE_CLASS_TEXT, EditorInfo.IME_ACTION_SEND, 42, label)\n+                action shouldBe EditorInfo.IME_ACTION_SEND\n+                enterLabel(action, label, 0) shouldBe \"Theme send\"\n+                enterLabel(action, label, 2) shouldBe \"Theme send\"\n+            }\n+        }\n+\n+        \"an unspecified custom ID retains the editor's standard action\" {\n+            val action = EditorEnterAction.resolve(\n+                InputType.TYPE_CLASS_TEXT,\n+                EditorInfo.IME_ACTION_SEARCH,\n+                EditorInfo.IME_ACTION_UNSPECIFIED,\n+                \"Find in document\",\n+            )\n+            action shouldBe EditorInfo.IME_ACTION_SEARCH\n+            enterLabel(action, \"Find in document\", 0) shouldBe \"Theme search\"\n+            enterLabel(action, \"Find in document\", 2) shouldBe \"Find in document\"\n+        }\n+\n+        \"NO_ENTER_ACTION suppresses both standard and custom actions regardless of label mode\" {\n+            for (custom in listOf(false, true)) {\n+                val action = EditorEnterAction.resolve(\n+                    InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE,\n+                    EditorInfo.IME_ACTION_SEND or EditorInfo.IME_FLAG_NO_ENTER_ACTION,\n+                    if (custom) 42 else EditorInfo.IME_ACTION_UNSPECIFIED,\n+                    if (custom) \"Approve\" else null,\n+                )\n+                action shouldBe null\n+                for (mode in 0..3) enterLabel(action, \"Approve\", mode) shouldBe \"Theme return\"\n+            }\n+        }\n+\n+        \"TYPE_NULL always sends a Return key even when an app supplies an action\" {\n+            val action = EditorEnterAction.resolve(InputType.TYPE_NULL, EditorInfo.IME_ACTION_SEARCH, 42, \"Approve\")\n+            action shouldBe null\n+            for (mode in 0..3) enterLabel(action, \"Approve\", mode) shouldBe \"Theme return\"\n+        }\n+\n+        \"a multiline flag alone does not discard an explicit Send action\" {\n+            val type = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE\n+            EditorEnterAction.resolve(type, EditorInfo.IME_ACTION_SEND, 0, null) shouldBe EditorInfo.IME_ACTION_SEND\n+            EditorEnterAction.resolve(type, EditorInfo.IME_ACTION_UNSPECIFIED, 0, null) shouldBe null\n+            enterLabel(EditorInfo.IME_ACTION_SEND, null, 0) shouldBe \"Theme send\"\n+        }\n+\n+        \"app-only labels never show null while app-preferred mode falls back to the theme action\" {\n+            for (label in listOf(null, \"\")) {\n+                enterLabel(EditorInfo.IME_ACTION_SEARCH, label, 1) shouldBe \"Theme return\"\n+                enterLabel(EditorInfo.IME_ACTION_SEARCH, label, 2) shouldBe \"Theme search\"\n+            }\n+            enterLabel(EditorInfo.IME_ACTION_SEARCH, \"App search\", 0) shouldBe \"Theme search\"\n+            enterLabel(EditorInfo.IME_ACTION_SEARCH, \"App search\", 1) shouldBe \"App search\"\n+            enterLabel(EditorInfo.IME_ACTION_SEARCH, \"App search\", 2) shouldBe \"App search\"\n+            enterLabel(EditorInfo.IME_ACTION_SEARCH, \"App search\", 3) shouldBe \"Theme search\"\n+        }\n+\n+        \"invalid theme modes retain the existing never-use-app-label fallback\" {\n+            for (mode in listOf(-1, 4, Int.MAX_VALUE)) {\n+                enterLabel(EditorInfo.IME_ACTION_SEARCH, \"App search\", mode) shouldBe \"Theme search\"\n+                enterLabel(42, \"Approve\", mode) shouldBe \"Theme return\"\n+            }\n+        }\n+\n+        \"a labeled actionId equal to NONE preserves the existing explicit custom-ID dispatch\" {\n+            val action = EditorEnterAction.resolve(InputType.TYPE_CLASS_TEXT, EditorInfo.IME_ACTION_SEND, EditorInfo.IME_ACTION_NONE, \"App action\")\n+            action shouldBe EditorInfo.IME_ACTION_NONE\n+            enterLabel(action, \"App action\", 2) shouldBe \"App action\"\n+            enterLabel(action, \"App action\", 0) shouldBe \"Theme return\"\n+        }\n+    })"},{"sha":"6813d36bd731957b2a9e3cc857e9a424a450c5be","filename":"app/src/test/java/com/osfans/trime/ime/keyboard/FeedbackRequestDispatcherTest.kt","status":"added","additions":190,"deletions":0,"changes":190,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackRequestDispatcherTest.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackRequestDispatcherTest.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackRequestDispatcherTest.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,190 @@\n+/* SPDX-License-Identifier: GPL-3.0-or-later */\n+package com.osfans.trime.ime.keyboard\n+\n+import io.kotest.core.spec.style.StringSpec\n+import io.kotest.matchers.shouldBe\n+import java.util.concurrent.ConcurrentLinkedQueue\n+import java.util.concurrent.CountDownLatch\n+import java.util.concurrent.TimeUnit\n+import java.util.concurrent.atomic.AtomicReference\n+\n+private fun runFeedbackWorker(block: () -> Unit) {\n+    val failure = AtomicReference<Throwable?>()\n+    val worker = Thread {\n+        try {\n+            block()\n+        } catch (error: Throwable) {\n+            failure.set(error)\n+        }\n+    }.apply { isDaemon = true }\n+    worker.start()\n+    worker.join(5_000)\n+    check(!worker.isAlive) { \"Feedback worker did not finish\" }\n+    failure.get()?.let { throw it }\n+}\n+\n+private class FeedbackOwnerQueue {\n+    val owner: Thread = Thread.currentThread()\n+    private val requests = ConcurrentLinkedQueue<() -> Unit>()\n+    val dispatcher = FeedbackRequestDispatcher(\n+        isOwnerThread = { Thread.currentThread() === owner },\n+        postToOwner = ::post,\n+    )\n+\n+    fun post(block: () -> Unit) {\n+        requests.add(block)\n+    }\n+\n+    fun drain() {\n+        check(Thread.currentThread() === owner)\n+        while (true) (requests.poll() ?: return).invoke()\n+    }\n+}\n+\n+class FeedbackRequestDispatcherTest :\n+    StringSpec({\n+        \"a request already on the owner runs immediately without posting\" {\n+            val owner = Thread.currentThread()\n+            val calls = mutableListOf<Thread>()\n+            val dispatcher = FeedbackRequestDispatcher(\n+                isOwnerThread = { Thread.currentThread() === owner },\n+                postToOwner = { error(\"An owner request must not be posted\") },\n+            )\n+            dispatcher.dispatch { calls.add(Thread.currentThread()) }\n+            calls shouldBe listOf(owner)\n+        }\n+\n+        \"a real worker queues feedback without touching its owner state\" {\n+            val queue = FeedbackOwnerQueue()\n+            val calls = mutableListOf<Thread>()\n+            runFeedbackWorker { queue.dispatcher.dispatch { calls.add(Thread.currentThread()) } }\n+            calls shouldBe emptyList()\n+            queue.drain()\n+            calls shouldBe listOf(queue.owner)\n+        }\n+\n+        \"a lifecycle change drops old queued work while accepting a new request\" {\n+            val queue = FeedbackOwnerQueue()\n+            val spoken = mutableListOf<String>()\n+            runFeedbackWorker { queue.dispatcher.dispatch { spoken.add(\"old input\") } }\n+            queue.dispatcher.invalidate()\n+            runFeedbackWorker { queue.dispatcher.dispatch { spoken.add(\"new input\") } }\n+            queue.drain()\n+            spoken shouldBe listOf(\"new input\")\n+        }\n+\n+        \"invalidation also rejects a worker delayed before its post reaches the queue\" {\n+            val owner = Thread.currentThread()\n+            val requests = ConcurrentLinkedQueue<() -> Unit>()\n+            val enteringPost = CountDownLatch(1)\n+            val allowPost = CountDownLatch(1)\n+            val failure = AtomicReference<Throwable?>()\n+            var executions = 0\n+            val dispatcher = FeedbackRequestDispatcher(\n+                isOwnerThread = { Thread.currentThread() === owner },\n+                postToOwner = { request ->\n+                    enteringPost.countDown()\n+                    check(allowPost.await(5, TimeUnit.SECONDS))\n+                    requests.add(request)\n+                },\n+            )\n+            val worker = Thread {\n+                try {\n+                    dispatcher.dispatch { executions++ }\n+                } catch (error: Throwable) {\n+                    failure.set(error)\n+                }\n+            }.apply { isDaemon = true }\n+            worker.start()\n+            try {\n+                check(enteringPost.await(5, TimeUnit.SECONDS))\n+                dispatcher.invalidate()\n+            } finally {\n+                allowPost.countDown()\n+                worker.join(5_000)\n+            }\n+            worker.isAlive shouldBe false\n+            failure.get()?.let { throw it }\n+            requests.size shouldBe 1\n+            checkNotNull(requests.poll()).invoke()\n+            executions shouldBe 0\n+        }\n+\n+        \"worker speech requests retain the latest text until their resource becomes ready\" {\n+            val queue = FeedbackOwnerQueue()\n+            val backendThreads = mutableListOf<Thread>()\n+            val spoken = mutableListOf<String>()\n+            var pending: String? = null\n+            var completion: ((Boolean) -> Unit)? = null\n+            val resource = FeedbackResource<Any> { }\n+            resource.init()\n+            fun speakPending() {\n+                pending?.let(spoken::add)\n+                pending = null\n+            }\n+            fun request(text: String) {\n+                queue.dispatcher.dispatch {\n+                    pending = text\n+                    val value = resource.acquire(\n+                        enabled = true,\n+                        create = { complete ->\n+                            backendThreads.add(Thread.currentThread())\n+                            completion = complete\n+                            Any()\n+                        },\n+                        onInitialized = { _, ready ->\n+                            backendThreads.add(Thread.currentThread())\n+                            if (ready) speakPending() else pending = null\n+                        },\n+                    )\n+                    if (value == null) {\n+                        pending = null\n+                    } else if (resource.ready === value) {\n+                        speakPending()\n+                    }\n+                }\n+            }\n+            runFeedbackWorker { request(\"committed text\") }\n+            runFeedbackWorker { request(\"latest key\") }\n+            backendThreads shouldBe emptyList()\n+            queue.drain()\n+            backendThreads shouldBe listOf(queue.owner)\n+            spoken shouldBe emptyList()\n+            runFeedbackWorker { queue.post { checkNotNull(completion)(true) } }\n+            queue.drain()\n+            backendThreads shouldBe listOf(queue.owner, queue.owner)\n+            spoken shouldBe listOf(\"latest key\")\n+            resource.destroy()\n+        }\n+\n+        \"a queued old request cannot allocate a resource after destruction and reinitialization\" {\n+            val queue = FeedbackOwnerQueue()\n+            val created = mutableListOf<String>()\n+            val released = mutableListOf<String>()\n+            val resource = FeedbackResource<String> { released.add(it) }\n+            resource.init()\n+            fun request(text: String) {\n+                queue.dispatcher.dispatch {\n+                    resource.acquire(\n+                        enabled = true,\n+                        create = { complete ->\n+                            created.add(text)\n+                            complete(true)\n+                            text\n+                        },\n+                    )\n+                }\n+            }\n+            runFeedbackWorker { request(\"old input\") }\n+            queue.dispatcher.invalidate()\n+            resource.destroy()\n+            queue.dispatcher.invalidate()\n+            resource.init()\n+            runFeedbackWorker { request(\"new input\") }\n+            queue.drain()\n+            created shouldBe listOf(\"new input\")\n+            resource.ready shouldBe \"new input\"\n+            resource.destroy()\n+            released shouldBe listOf(\"new input\")\n+        }\n+    })"},{"sha":"c910bde320bedb6ee6d63b5e4c8eb02fc5d6bd5d","filename":"app/src/test/java/com/osfans/trime/ime/keyboard/FeedbackResourceTest.kt","status":"added","additions":212,"deletions":0,"changes":212,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackResourceTest.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackResourceTest.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackResourceTest.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,212 @@\n+/* SPDX-License-Identifier: GPL-3.0-or-later */\n+package com.osfans.trime.ime.keyboard\n+\n+import io.kotest.assertions.throwables.shouldThrow\n+import io.kotest.core.spec.style.StringSpec\n+import io.kotest.matchers.shouldBe\n+\n+private class TestFeedbackResource(val id: Int)\n+\n+class FeedbackResourceTest :\n+    StringSpec({\n+        \"disabled feedback and initialization alone allocate no resources\" {\n+            val released = mutableListOf<TestFeedbackResource>()\n+            val owner = FeedbackResource<TestFeedbackResource> { released.add(it) }\n+            var creations = 0\n+            val create: ((Boolean) -> Unit) -> TestFeedbackResource = {\n+                TestFeedbackResource(++creations)\n+            }\n+            owner.canAcquire shouldBe false\n+            owner.acquire(enabled = true, create = create) shouldBe null\n+            owner.init()\n+            owner.canAcquire shouldBe true\n+            owner.acquire(enabled = false, create = create) shouldBe null\n+            owner.canAcquire shouldBe true\n+            owner.current shouldBe null\n+            owner.ready shouldBe null\n+            owner.destroy()\n+            owner.canAcquire shouldBe false\n+            creations shouldBe 0\n+            released shouldBe emptyList()\n+        }\n+\n+        \"the first enabled request creates once and waits for readiness\" {\n+            val owner = FeedbackResource<TestFeedbackResource> { }\n+            val notifications = mutableListOf<Int>()\n+            var creations = 0\n+            var complete: ((Boolean) -> Unit)? = null\n+            val create: ((Boolean) -> Unit) -> TestFeedbackResource = {\n+                complete = it\n+                TestFeedbackResource(++creations)\n+            }\n+            owner.init()\n+            val first = owner.acquire(true, create) { resource, _ -> notifications.add(resource.id) }\n+            owner.ready shouldBe null\n+            repeat(5) { owner.acquire(true, create) shouldBe first }\n+            creations shouldBe 1\n+            notifications shouldBe emptyList()\n+            checkNotNull(complete)(true)\n+            owner.ready shouldBe first\n+            notifications shouldBe listOf(1)\n+            // Some backends can notify repeatedly; delivery still belongs to one initialization.\n+            checkNotNull(complete)(true)\n+            checkNotNull(complete)(false)\n+            owner.ready shouldBe first\n+            notifications shouldBe listOf(1)\n+            owner.acquire(false, create) shouldBe null\n+            creations shouldBe 1\n+            owner.destroy()\n+        }\n+\n+        \"an immediate callback is delivered only after the factory returns its resource\" {\n+            val events = mutableListOf<String>()\n+            val owner = FeedbackResource<TestFeedbackResource> { }\n+            owner.init()\n+            val resource = owner.acquire(\n+                enabled = true,\n+                create = { complete ->\n+                    events.add(\"create\")\n+                    complete(true)\n+                    events.add(\"return\")\n+                    TestFeedbackResource(7)\n+                },\n+                onInitialized = { value, ready ->\n+                    events.add(\"ready ${value.id} $ready\")\n+                    owner.ready shouldBe value\n+                },\n+            )\n+            events shouldBe listOf(\"create\", \"return\", \"ready 7 true\")\n+            owner.ready shouldBe resource\n+            owner.destroy()\n+        }\n+\n+        \"callbacks from a destroyed pending resource cannot ready its replacement\" {\n+            val released = mutableListOf<Int>()\n+            val notifications = mutableListOf<Int>()\n+            val completions = mutableListOf<(Boolean) -> Unit>()\n+            val owner = FeedbackResource<TestFeedbackResource> { released.add(it.id) }\n+            var creations = 0\n+            val create: ((Boolean) -> Unit) -> TestFeedbackResource = {\n+                completions.add(it)\n+                TestFeedbackResource(++creations)\n+            }\n+            val initialized: (TestFeedbackResource, Boolean) -> Unit = { value, _ -> notifications.add(value.id) }\n+            owner.init()\n+            owner.acquire(true, create, initialized)\n+            owner.destroy()\n+            owner.destroy()\n+            owner.init()\n+            val replacement = owner.acquire(true, create, initialized)\n+            completions[0](true)\n+            completions[0](false)\n+            owner.current shouldBe replacement\n+            owner.ready shouldBe null\n+            notifications shouldBe emptyList()\n+            released shouldBe listOf(1)\n+            completions[1](true)\n+            owner.ready shouldBe replacement\n+            notifications shouldBe listOf(2)\n+            owner.destroy()\n+            completions[1](true)\n+            released shouldBe listOf(1, 2)\n+            notifications shouldBe listOf(2)\n+            owner.current shouldBe null\n+        }\n+\n+        \"a failed initialization releases once and does not retry on every key\" {\n+            val released = mutableListOf<Int>()\n+            val results = mutableListOf<Boolean>()\n+            val owner = FeedbackResource<TestFeedbackResource> { released.add(it.id) }\n+            var creations = 0\n+            var complete: ((Boolean) -> Unit)? = null\n+            val create: ((Boolean) -> Unit) -> TestFeedbackResource = {\n+                complete = it\n+                TestFeedbackResource(++creations)\n+            }\n+            owner.init()\n+            owner.acquire(true, create) { _, ready -> results.add(ready) }\n+            checkNotNull(complete)(false)\n+            checkNotNull(complete)(true)\n+            owner.canAcquire shouldBe false\n+            owner.current shouldBe null\n+            owner.ready shouldBe null\n+            repeat(5) { owner.acquire(true, create) shouldBe null }\n+            creations shouldBe 1\n+            released shouldBe listOf(1)\n+            results shouldBe listOf(false)\n+            owner.destroy()\n+            owner.init()\n+            owner.canAcquire shouldBe true\n+            owner.acquire(true, create)\n+            creations shouldBe 2\n+            checkNotNull(complete)(true)\n+            owner.ready?.id shouldBe 2\n+            owner.destroy()\n+            released shouldBe listOf(1, 2)\n+        }\n+\n+        \"factory exceptions do not strand an attempt or trigger an automatic retry loop\" {\n+            var creations = 0\n+            val owner = FeedbackResource<TestFeedbackResource> { }\n+            val create: ((Boolean) -> Unit) -> TestFeedbackResource = {\n+                creations++\n+                throw IllegalStateException(\"backend unavailable\")\n+            }\n+            owner.init()\n+            shouldThrow<IllegalStateException> { owner.acquire(true, create) }\n+            owner.canAcquire shouldBe false\n+            owner.current shouldBe null\n+            owner.ready shouldBe null\n+            owner.acquire(true, create) shouldBe null\n+            creations shouldBe 1\n+            owner.destroy()\n+            owner.init()\n+            owner.canAcquire shouldBe true\n+            owner.acquire(true, { TestFeedbackResource(2) })?.id shouldBe 2\n+            owner.destroy()\n+        }\n+\n+        \"an immediate initialization failure releases only after the factory returns\" {\n+            val events = mutableListOf<String>()\n+            val owner = FeedbackResource<TestFeedbackResource> { events.add(\"release ${it.id}\") }\n+            owner.init()\n+            val result = owner.acquire(\n+                enabled = true,\n+                create = { complete ->\n+                    complete(false)\n+                    events.add(\"return\")\n+                    TestFeedbackResource(3)\n+                },\n+                onInitialized = { _, ready -> events.add(\"initialized $ready\") },\n+            )\n+            result shouldBe null\n+            owner.ready shouldBe null\n+            events shouldBe listOf(\"return\", \"release 3\", \"initialized false\")\n+            owner.destroy()\n+            events shouldBe listOf(\"return\", \"release 3\", \"initialized false\")\n+        }\n+\n+        \"destroying during creation releases the returned resource without publishing it\" {\n+            val released = mutableListOf<Int>()\n+            var notifications = 0\n+            val owner = FeedbackResource<TestFeedbackResource> { released.add(it.id) }\n+            owner.init()\n+            val result = owner.acquire(\n+                enabled = true,\n+                create = { complete ->\n+                    complete(true)\n+                    owner.destroy()\n+                    owner.init()\n+                    TestFeedbackResource(1)\n+                },\n+                onInitialized = { _, _ -> notifications++ },\n+            )\n+            result shouldBe null\n+            released shouldBe listOf(1)\n+            notifications shouldBe 0\n+            owner.current shouldBe null\n+            owner.acquire(true, { TestFeedbackResource(2) })?.id shouldBe 2\n+            owner.destroy()\n+            released shouldBe listOf(1, 2)\n+        }\n+    })"},{"sha":"faeadf89ac008b0d9af56a27ea184d4001519e3f","filename":"app/src/test/java/com/osfans/trime/ime/keyboard/KeyActionTest.kt","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyActionTest.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyActionTest.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Ftest%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyActionTest.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -20,6 +20,7 @@ class KeyActionTest :\n         // The Android key-name lookup is a platform call that throws when not\n         // mocked; the Rime key table is the path under test.\n         beforeTest { KeyCode.androidKeyNameToCode = { 0 } }\n+        afterSpec { KeyCode.androidKeyNameToCode = KeyCode.defaultAndroidKeyNameToCode }\n \n         val presetKeys = ThemeTestSupport.decodeBuiltinTheme(\"trime.yaml\").presetKeys\n "},{"sha":"6b724431b6b3168d7a2be27e7e9160575903430d","filename":"build-logic/convention/src/main/kotlin/ProjectExtensions.kt","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/build-logic%2Fconvention%2Fsrc%2Fmain%2Fkotlin%2FProjectExtensions.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/build-logic%2Fconvention%2Fsrc%2Fmain%2Fkotlin%2FProjectExtensions.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/build-logic%2Fconvention%2Fsrc%2Fmain%2Fkotlin%2FProjectExtensions.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -16,6 +16,9 @@ fun Project.runCmd(\n ): String {\n     val output = providers.exec {\n         commandLine = cmd.split(\" \")\n+        // A failing command must not break the configuration, the default value\n+        // is used instead.\n+        setIgnoreExitValue(true)\n     }\n     return if (output.result.get().exitValue == 0) {\n         output.standardOutput.asText.get().trim()"}]}