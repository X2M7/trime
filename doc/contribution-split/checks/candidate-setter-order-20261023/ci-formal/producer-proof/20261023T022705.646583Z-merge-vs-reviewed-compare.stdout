s://github.com/osfans/trime/commit/7f909060a1d42198e749eb1f9a66399f76bf8710"}]}],"files":[{"sha":"ae775f3c69d70b6c20276ce126426190ffb3c3b7","filename":".github/workflows/check-ci.yml","status":"added","additions":39,"deletions":0,"changes":39,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fcheck-ci.yml","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fcheck-ci.yml","contents_url":"https://api.github.com/repos/osfans/trime/contents/.github%2Fworkflows%2Fcheck-ci.yml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,39 @@\n+# SPDX-FileCopyrightText: 2015 - 2026 Rime community\n+#\n+# SPDX-License-Identifier: GPL-3.0-or-later\n+\n+name: Code Checks\n+\n+on:\n+  workflow_call:\n+\n+env:\n+  CI_NAME: Code Checks\n+\n+jobs:\n+  lint-and-test:\n+    runs-on: ubuntu-26.04\n+    steps:\n+      - name: Fetch source code\n+        uses: actions/checkout@v7\n+        with:\n+          submodules: recursive\n+\n+      - name: Setup Java\n+        uses: actions/setup-java@v6\n+        with:\n+          distribution: \"temurin\"\n+          java-version: 25\n+          # will restore cache of dependencies and wrappers\n+          cache: 'gradle'\n+\n+      - name: Setup Android SDK\n+        uses: android-actions/setup-android@v4\n+        with:\n+          packages: 'platform-tools'\n+\n+      - name: Check code style\n+        run: make style-lint\n+\n+      - name: Run unit tests and lint\n+        run: make check"},{"sha":"26296e6231be7aa61dc8135ae40a016f90416a13","filename":".github/workflows/commit-ci.yml","status":"modified","additions":4,"deletions":10,"changes":14,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fcommit-ci.yml","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fcommit-ci.yml","contents_url":"https://api.github.com/repos/osfans/trime/contents/.github%2Fworkflows%2Fcommit-ci.yml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -8,7 +8,11 @@ on: [push]\n env:\n   CI_NAME: Commit CI\n jobs:\n+  check:\n+    uses: ./.github/workflows/check-ci.yml\n+\n   build:\n+    needs: check\n     runs-on: ${{ matrix.os }}\n     strategy:\n       fail-fast: false\n@@ -51,11 +55,6 @@ jobs:\n         run: |\n           sdkmanager --install \"cmake;3.31.6\"\n \n-      - name: Check code style\n-        if: ${{ startsWith(matrix.os, 'ubuntu') }}\n-        run: |\n-          make style-lint\n-\n       - name: Calculate JNI cache hash\n         id: cache-hash\n         run: |\n@@ -68,11 +67,6 @@ jobs:\n           path: \"app/prebuilt\"\n           key: ${{ matrix.os }}-trime-jni-debug-${{ steps.cache-hash.outputs.native-cache-hash }}\n \n-      - name: Fetch submodules\n-        if: ${{ !steps.jni-cache.outputs.cache-hit }}\n-        run: |\n-          git submodule update --init --recursive\n-\n       - name: Build debug Trime\n         run: |\n           make debug"},{"sha":"894f96f7f3361456ce3d2f95adf98d8331e98ff9","filename":".github/workflows/nightly-ci.yml","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fnightly-ci.yml","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fnightly-ci.yml","contents_url":"https://api.github.com/repos/osfans/trime/contents/.github%2Fworkflows%2Fnightly-ci.yml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -11,8 +11,13 @@ on:\n env:\n   CI_NAME: Nightly CI\n jobs:\n+  check:\n+    if: ${{ github.repository == 'osfans/trime' && github.ref == 'refs/heads/develop' }}\n+    uses: ./.github/workflows/check-ci.yml\n+\n   build:\n     if: ${{ github.repository == 'osfans/trime' && github.ref == 'refs/heads/develop' }}\n+    needs: check\n     runs-on: ubuntu-26.04\n     steps:\n       - name: Checkout"},{"sha":"bf3a7867c4620c17bdaff6f066049977f51d17a0","filename":".github/workflows/pull-request-ci.yml","status":"modified","additions":4,"deletions":10,"changes":14,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fpull-request-ci.yml","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Fpull-request-ci.yml","contents_url":"https://api.github.com/repos/osfans/trime/contents/.github%2Fworkflows%2Fpull-request-ci.yml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -15,7 +15,11 @@ on:\n env:\n   CI_NAME: Pull Request CI\n jobs:\n+  check:\n+    uses: ./.github/workflows/check-ci.yml\n+\n   build:\n+    needs: check\n     runs-on: ${{ matrix.os }}\n     strategy:\n       fail-fast: false\n@@ -58,11 +62,6 @@ jobs:\n         run: |\n           sdkmanager --install \"cmake;3.31.6\"\n \n-      - name: Check code style\n-        if: ${{ startsWith(matrix.os, 'ubuntu') }}\n-        run: |\n-          make style-lint\n-\n       - name: Calculate JNI cache hash\n         id: cache-hash\n         run: |\n@@ -75,11 +74,6 @@ jobs:\n           path: \"app/prebuilt\"\n           key: ${{ matrix.os }}-trime-jni-debug-${{ steps.cache-hash.outputs.native-cache-hash }}\n \n-      - name: Fetch submodules\n-        if: ${{ !steps.jni-cache.outputs.cache-hit }}\n-        run: |\n-          git submodule update --init --recursive\n-\n       - name: Build debug Trime\n         run: |\n           make debug"},{"sha":"2d3911dc68400c91077bcc7c01367ca121c3680c","filename":".github/workflows/release-ci.yml","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Frelease-ci.yml","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/.github%2Fworkflows%2Frelease-ci.yml","contents_url":"https://api.github.com/repos/osfans/trime/contents/.github%2Fworkflows%2Frelease-ci.yml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -11,7 +11,11 @@ on:\n env:\n   CI_NAME: Release CI\n jobs:\n+  check:\n+    uses: ./.github/workflows/check-ci.yml\n+\n   build:\n+    needs: check\n     runs-on: ubuntu-26.04\n     steps:\n       - name: Checkout"},{"sha":"26bc1f9ba41f2d8114ae42c5c6d7fb38b0a6b0e4","filename":"Makefile","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/Makefile","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/Makefile","contents_url":"https://api.github.com/repos/osfans/trime/contents/Makefile?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -15,7 +15,7 @@ else\n endif\n \n \n-.PHONY: all clean build debug spotlessCheck spotlessApply clang-format-lint clang-format style-lint \\\n+.PHONY: all clean build debug check spotlessCheck spotlessApply clang-format-lint clang-format style-lint \\\n style-apply patch-apply release install translate ndk android\n \n all: release\n@@ -27,6 +27,10 @@ clean:\n build: style-lint\n \t$(GRADLEW) build\n \n+# Run unit tests and lint\n+check:\n+\t$(GRADLEW) :app:check\n+\n spotlessCheck:\n \t$(GRADLEW) spotlessCheck\n "},{"sha":"9cd040df94f10434ffce02d48bbc203061894c1a","filename":"app/src/main/AndroidManifest.xml","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2FAndroidManifest.xml","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2FAndroidManifest.xml","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2FAndroidManifest.xml?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -12,6 +12,12 @@ SPDX-License-Identifier: GPL-3.0-or-later\n     <uses-permission android:name=\"android.permission.VIBRATE\" />\n     <uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\" />\n \n+    <queries>\n+        <intent>\n+            <action android:name=\"android.intent.action.TTS_SERVICE\" />\n+        </intent>\n+    </queries>\n+\n     <application\n         android:name=\"com.osfans.trime.TrimeApplication\"\n         android:allowBackup=\"true\""},{"sha":"6d8937cac5d5b185f8a5eca88e3fb38088876730","filename":"app/src/main/java/com/osfans/trime/data/prefs/AppPrefs.kt","status":"modified","additions":0,"deletions":7,"changes":7,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Fprefs%2FAppPrefs.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Fprefs%2FAppPrefs.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Fprefs%2FAppPrefs.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -159,7 +159,6 @@ class AppPrefs(\n             const val HOOK_SHIFT_NUM = \"hook_shift_num\"\n             const val HOOK_SHIFT_SYMBOL = \"hook_shift_symbol\"\n             const val HOOK_SHIFT_ARROW = \"hook_shift_arrow\"\n-            const val HOOK_SHIFT_LOCK = \"hook_shift_lock\"\n \n             const val MAX_SPAN_COUNT = \"max_span_count\"\n             const val MAX_SPAN_COUNT_LANDSCAPE = \"max_span_count_landscape\"\n@@ -343,12 +342,6 @@ class AppPrefs(\n         val hookShiftNum = switch(R.string.hook_shift_num, HOOK_SHIFT_NUM, false)\n         val hookShiftSymbol = switch(R.string.hook_shift_symbol, HOOK_SHIFT_SYMBOL, false)\n         val hookShiftArrow = switch(R.string.hook_shift_arrow, HOOK_SHIFT_ARROW, true)\n-        val hookShiftLock = switch(\n-            R.string.hook_shift_lock,\n-            HOOK_SHIFT_LOCK,\n-            true,\n-            R.string.hook_shift_lock_summary,\n-        )\n     }\n \n     class Candidates("},{"sha":"d502884cf6ba40054b1b0f897f2494d60aa7bd72","filename":"app/src/main/java/com/osfans/trime/data/theme/ThemeLoader.kt","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FThemeLoader.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FThemeLoader.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fdata%2Ftheme%2FThemeLoader.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -254,7 +254,11 @@ object ThemeLoader {\n \n     /** Whether this file really lives in [root]: `..` and absolute ids are escapes. */\n     private fun File.isInside(root: File): Boolean = runCatching {\n-        canonicalFile.toPath().startsWith(root.canonicalFile.toPath())\n+        // java.nio.file is unavailable before API 26, so compare canonical\n+        // paths with an explicit separator to keep the boundary check.\n+        val rootPath = root.canonicalFile.path.trimEnd(File.separatorChar)\n+        val filePath = canonicalFile.path\n+        filePath == rootPath || filePath.startsWith(rootPath + File.separator)\n     }.getOrDefault(false)\n \n     /**"},{"sha":"c6e451941c9890987f9913f7a3fc7b6e2dab110e","filename":"app/src/main/java/com/osfans/trime/ime/broadcast/EnterKeyDisplayDelegate.kt","status":"modified","additions":19,"deletions":55,"changes":74,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fbroadcast%2FEnterKeyDisplayDelegate.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fbroadcast%2FEnterKeyDisplayDelegate.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fbroadcast%2FEnterKeyDisplayDelegate.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -7,10 +7,10 @@ package com.osfans.trime.ime.broadcast\n \n import android.view.inputmethod.EditorInfo\n import com.osfans.trime.data.theme.Theme\n+import com.osfans.trime.ime.core.EditorEnterAction\n import org.kodein.di.DI\n import org.kodein.di.DIAware\n import org.kodein.di.instance\n-import splitties.bitflags.hasFlag\n \n class EnterKeyDisplayDelegate(override val di: DI) : DIAware {\n     private val broadcaster: InputBroadcaster by instance()\n@@ -32,64 +32,28 @@ class EnterKeyDisplayDelegate(override val di: DI) : DIAware {\n     var keyLabel: String = DEFAULT_LABEL\n         private set\n \n-    private var actionLabel: String = DEFAULT_LABEL\n-\n-    private fun labelFromEditorInfo(info: EditorInfo): String {\n-        if (info.imeOptions.hasFlag(EditorInfo.IME_FLAG_NO_ENTER_ACTION)) {\n-            return theme.style.enterLabels.default\n-        } else {\n-            val action = info.imeOptions and EditorInfo.IME_MASK_ACTION\n-            val actionLabel = info.actionLabel\n-            when (mode) {\n-                Mode.ACTION_LABEL_ONLY -> {\n-                    return actionLabel.toString()\n-                }\n-\n-                Mode.ACTION_LABEL_PREFERRED -> {\n-                    return if (!actionLabel.isNullOrEmpty()) {\n-                        actionLabel.toString()\n-                    } else {\n-                        theme.style.enterLabels.default\n-                    }\n-                }\n-\n-                Mode.CUSTOM_PREFERRED,\n-                Mode.ACTION_LABEL_NEVER,\n-                -> {\n-                    return when (action) {\n-                        EditorInfo.IME_ACTION_DONE -> theme.style.enterLabels.done\n-\n-                        EditorInfo.IME_ACTION_GO -> theme.style.enterLabels.go\n-\n-                        EditorInfo.IME_ACTION_NEXT -> theme.style.enterLabels.next\n-\n-                        EditorInfo.IME_ACTION_PREVIOUS -> theme.style.enterLabels.pre\n-\n-                        EditorInfo.IME_ACTION_SEARCH -> theme.style.enterLabels.search\n-\n-                        EditorInfo.IME_ACTION_SEND -> theme.style.enterLabels.send\n+    fun updateLabelOnEditorInfo(info: EditorInfo) {\n+        updateLabel(info.inputType, info.imeOptions, info.actionId, info.actionLabel)\n+    }\n \n-                        else -> {\n-                            if (mode == Mode.ACTION_LABEL_NEVER) {\n-                                theme.style.enterLabels.default\n-                            } else {\n-                                if (!actionLabel.isNullOrEmpty()) {\n-                                    actionLabel.toString()\n-                                } else {\n-                                    theme.style.enterLabels.default\n-                                }\n-                            }\n-                        }\n-                    }\n+    /** Updates the visible text before notifying listeners, without repeating unchanged labels. */\n+    internal fun updateLabel(inputType: Int, imeOptions: Int, actionId: Int, actionLabel: CharSequence?) {\n+        val action = EditorEnterAction.resolve(inputType, imeOptions, actionId, actionLabel)\n+        val label = EditorEnterAction.label(action, actionLabel, mode.ordinal, theme.style.enterLabels.default) { themeAction ->\n+            with(theme.style.enterLabels) {\n+                when (themeAction) {\n+                    EditorInfo.IME_ACTION_DONE -> done\n+                    EditorInfo.IME_ACTION_GO -> go\n+                    EditorInfo.IME_ACTION_NEXT -> next\n+                    EditorInfo.IME_ACTION_PREVIOUS -> pre\n+                    EditorInfo.IME_ACTION_SEARCH -> search\n+                    EditorInfo.IME_ACTION_SEND -> send\n+                    else -> null\n                 }\n             }\n         }\n-    }\n-\n-    fun updateLabelOnEditorInfo(info: EditorInfo) {\n-        actionLabel = labelFromEditorInfo(info)\n-        if (keyLabel == actionLabel) return\n-        keyLabel = actionLabel\n+        if (keyLabel == label) return\n+        keyLabel = label\n         broadcaster.onEnterKeyLabelUpdate(keyLabel)\n     }\n }"},{"sha":"210a416e201495b1451dc7028d642d4eda34e127","filename":"app/src/main/java/com/osfans/trime/ime/core/EditorEnterAction.kt","status":"added","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FEditorEnterAction.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FEditorEnterAction.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FEditorEnterAction.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,46 @@\n+/* SPDX-License-Identifier: GPL-3.0-or-later */\n+package com.osfans.trime.ime.core\n+\n+import android.text.InputType\n+import android.view.inputmethod.EditorInfo\n+\n+/** The action shown on Return and the action sent to the editor share this decision. */\n+internal object EditorEnterAction {\n+    /** Null means a key event, including a multiline editor's NO_ENTER_ACTION request. */\n+    fun resolve(inputType: Int, imeOptions: Int, actionId: Int, actionLabel: CharSequence?): Int? {\n+        if (inputType and InputType.TYPE_MASK_CLASS == InputType.TYPE_NULL ||\n+            imeOptions and EditorInfo.IME_FLAG_NO_ENTER_ACTION != 0\n+        ) {\n+            return null\n+        }\n+        if (!actionLabel.isNullOrEmpty() && actionId != EditorInfo.IME_ACTION_UNSPECIFIED) return actionId\n+        return (imeOptions and EditorInfo.IME_MASK_ACTION).takeUnless {\n+            it == EditorInfo.IME_ACTION_NONE || it == EditorInfo.IME_ACTION_UNSPECIFIED\n+        }\n+    }\n+\n+    /** [mode] retains the theme's enter_label_mode values 0 through 3. */\n+    fun label(\n+        actionId: Int?,\n+        actionLabel: CharSequence?,\n+        mode: Int,\n+        defaultLabel: String,\n+        standardLabel: (Int) -> String?,\n+    ): String {\n+        if (actionId == null) return defaultLabel\n+        val appLabel = actionLabel?.toString()?.takeIf { it.isNotEmpty() }\n+        return when (mode) {\n+            // Only app labels: a missing label must not be rendered as the literal \"null\".\n+            1 -> appLabel ?: defaultLabel\n+\n+            // App first, then the theme's label for the action that will actually be sent.\n+            2 -> appLabel ?: standardLabel(actionId) ?: defaultLabel\n+\n+            // Theme first, with an app label for actions outside the standard action set.\n+            3 -> standardLabel(actionId) ?: appLabel ?: defaultLabel\n+\n+            // Never use app labels, including an invalid theme mode's existing fallback.\n+            else -> standardLabel(actionId) ?: defaultLabel\n+        }\n+    }\n+}"},{"sha":"d2e71bfe8e274428512cf2ac2ea61ddda5775ff7","filename":"app/src/main/java/com/osfans/trime/ime/core/TrimeInputMethodService.kt","status":"modified","additions":6,"deletions":19,"changes":25,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FTrimeInputMethodService.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FTrimeInputMethodService.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fcore%2FTrimeInputMethodService.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -61,7 +61,6 @@ import kotlinx.coroutines.Job\n import kotlinx.coroutines.channels.Channel\n import kotlinx.coroutines.channels.consumeEach\n import kotlinx.coroutines.launch\n-import splitties.bitflags.hasFlag\n import splitties.systemservices.clipboardManager\n import splitties.systemservices.inputMethodManager\n import timber.log.Timber\n@@ -346,24 +345,12 @@ open class TrimeInputMethodService : LifecycleInputMethodService() {\n     }\n \n     private fun handleReturnKey() {\n-        currentInputEditorInfo.run {\n-            if (inputType and InputType.TYPE_MASK_CLASS == InputType.TYPE_NULL ||\n-                imeOptions.hasFlag(EditorInfo.IME_FLAG_NO_ENTER_ACTION)\n-            ) {\n-                sendDownUpKeyEvents(KeyEvent.KEYCODE_ENTER)\n-                return\n-            }\n-            if (!actionLabel.isNullOrEmpty() && actionId != EditorInfo.IME_ACTION_UNSPECIFIED) {\n-                currentInputConnection.performEditorAction(actionId)\n-                return\n-            }\n-            when (val action = imeOptions and EditorInfo.IME_MASK_ACTION) {\n-                EditorInfo.IME_ACTION_UNSPECIFIED,\n-                EditorInfo.IME_ACTION_NONE,\n-                -> sendDownUpKeyEvents(KeyEvent.KEYCODE_ENTER)\n-\n-                else -> currentInputConnection.performEditorAction(action)\n-            }\n+        val info = currentInputEditorInfo\n+        val action = EditorEnterAction.resolve(info.inputType, info.imeOptions, info.actionId, info.actionLabel)\n+        if (action == null) {\n+            sendDownUpKeyEvents(KeyEvent.KEYCODE_ENTER)\n+        } else {\n+            currentInputConnection.performEditorAction(action)\n         }\n     }\n "},{"sha":"2bb8b7e2a0e4bae87803ea9b7c9f21d0427bc880","filename":"app/src/main/java/com/osfans/trime/ime/keyboard/FeedbackRequestDispatcher.kt","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackRequestDispatcher.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackRequestDispatcher.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackRequestDispatcher.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,29 @@\n+/* SPDX-License-Identifier: GPL-3.0-or-later */\n+package com.osfans.trime.ime.keyboard\n+\n+import java.util.concurrent.atomic.AtomicLong\n+\n+/** Routes feedback requests to their owner thread without replaying a previous input's queue. */\n+internal class FeedbackRequestDispatcher(\n+    private val isOwnerThread: () -> Boolean,\n+    private val postToOwner: (() -> Unit) -> Unit,\n+) {\n+    private val generation = AtomicLong()\n+\n+    /** Call on the owner thread before clearing pending feedback or replacing its resources. */\n+    fun invalidate() {\n+        generation.incrementAndGet()\n+    }\n+\n+    fun dispatch(block: () -> Unit) {\n+        val submittedGeneration = generation.get()\n+        val guarded = {\n+            if (generation.get() == submittedGeneration) block()\n+        }\n+        if (isOwnerThread()) {\n+            guarded()\n+        } else {\n+            postToOwner(guarded)\n+        }\n+    }\n+}"},{"sha":"02d7eeb39c0edff5e3be0558a53b6d64bf1af6a2","filename":"app/src/main/java/com/osfans/trime/ime/keyboard/FeedbackResource.kt","status":"added","additions":84,"deletions":0,"changes":84,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackResource.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackResource.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FFeedbackResource.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -0,0 +1,84 @@\n+/* SPDX-License-Identifier: GPL-3.0-or-later */\n+package com.osfans.trime.ime.keyboard\n+\n+/** Main-thread owner of one lazily initialized feedback resource. */\n+internal class FeedbackResource<T : Any>(private val release: (T) -> Unit) {\n+    private class Attempt<T> {\n+        var resource: T? = null\n+        var result: Boolean? = null\n+        var delivered = false\n+        var ready = false\n+    }\n+\n+    private var initialized = false\n+    private var failed = false\n+    private var attempt: Attempt<T>? = null\n+\n+    val canAcquire: Boolean get() = initialized && !failed\n+    val current: T? get() = attempt?.resource\n+    val ready: T? get() = attempt?.takeIf { it.ready }?.resource\n+\n+    fun init() {\n+        initialized = true\n+    }\n+\n+    /**\n+     * Completion must run on the same thread as the owner. It may arrive before the factory\n+     * returns, after destruction, or after a replacement resource has already been created.\n+     * A failed initialization is retried only after destroy/init, not on every key press.\n+     */\n+    fun acquire(\n+        enabled: Boolean,\n+        create: ((Boolean) -> Unit) -> T,\n+        onInitialized: (T, Boolean) -> Unit = { _, _ -> },\n+    ): T? {\n+        if (!canAcquire || !enabled) return null\n+        attempt?.let { return it.resource }\n+        val request = Attempt<T>()\n+        attempt = request\n+        val resource = try {\n+            create { success ->\n+                if (initialized && attempt === request && request.result == null) {\n+                    request.result = success\n+                    publish(request, onInitialized)\n+                }\n+            }\n+        } catch (error: Throwable) {\n+            if (attempt === request) {\n+                attempt = null\n+                failed = true\n+            }\n+            throw error\n+        }\n+        request.resource = resource\n+        if (!initialized || attempt !== request) {\n+            release(resource)\n+            return null\n+        }\n+        publish(request, onInitialized)\n+        return resource.takeIf { attempt === request }\n+    }\n+\n+    private fun publish(request: Attempt<T>, onInitialized: (T, Boolean) -> Unit) {\n+        val resource = request.resource ?: return\n+        val success = request.result ?: return\n+        if (request.delivered) return\n+        request.delivered = true\n+        if (success) {\n+            request.ready = true\n+        } else {\n+            attempt = null\n+            failed = true\n+            release(resource)\n+        }\n+        onInitialized(resource, success)\n+    }\n+\n+    fun destroy() {\n+        initialized = false\n+        failed = false\n+        val previous = attempt\n+        attempt = null\n+        previous?.resource?.let(release)\n+    }\n+}"},{"sha":"2bba9a2ca30f8b2de91ea9fea095a2914eeb6ab5","filename":"app/src/main/java/com/osfans/trime/ime/keyboard/InputFeedbackManager.kt","status":"modified","additions":116,"deletions":25,"changes":141,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FInputFeedbackManager.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FInputFeedbackManager.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FInputFeedbackManager.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -10,12 +10,15 @@ import android.media.AudioAttributes\n import android.media.AudioManager\n import android.media.SoundPool\n import android.os.Build\n+import android.os.Handler\n+import android.os.Looper\n import android.os.VibrationEffect\n import android.speech.tts.TextToSpeech\n import android.util.SparseIntArray\n import android.view.HapticFeedbackConstants\n import android.view.KeyEvent\n import android.view.View\n+import androidx.annotation.MainThread\n import androidx.core.util.containsValue\n import com.osfans.trime.data.prefs.AppPrefs\n import com.osfans.trime.data.soundeffect.SoundEffectManager\n@@ -30,34 +33,104 @@ import java.util.concurrent.ConcurrentHashMap\n object InputFeedbackManager {\n     private val keyboardPrefs = AppPrefs.defaultInstance().keyboard\n \n-    private var tts: TextToSpeech? = null\n-    private var soundPool: SoundPool? = null\n+    private var applicationContext: Context? = null\n+    private val callbackHandler by lazy { Handler(Looper.getMainLooper()) }\n+    private val speechRequests = FeedbackRequestDispatcher(\n+        isOwnerThread = { Looper.myLooper() == Looper.getMainLooper() },\n+        postToOwner = { request -> callbackHandler.post { request() } },\n+    )\n+    private val speech = FeedbackResource<TextToSpeech> { it.shutdown() }\n+    private val sounds = FeedbackResource<SoundPool> { it.release() }\n+    private data class PendingSpeech(val text: String, val onCommit: Boolean)\n+    private var pendingSpeech: PendingSpeech? = null\n \n     private var effectPlayProgress = 0\n     private val cachedSoundIds = SparseIntArray()\n \n     private val loadedSounds = ConcurrentHashMap<String, Int>()\n-    private var effectHash = 0\n+    private val readySounds = mutableSetOf<Int>()\n+    private var effectHash: Int? = null\n \n+    @MainThread\n     fun init(context: Context) {\n+        resetSpeechRequests()\n+        applicationContext = context.applicationContext\n+        speech.init()\n+        sounds.init()\n+    }\n+\n+    @MainThread\n+    private fun resetSpeechRequests() {\n+        speechRequests.invalidate()\n+        pendingSpeech = null\n+        speech.ready?.stop()\n+    }\n+\n+    @MainThread\n+    private fun prepareSpeech(onCommit: Boolean) {\n+        val context = applicationContext ?: return\n         try {\n-            tts = TextToSpeech(context, null)\n-            soundPool =\n+            val resource = speech.acquire(\n+                enabled = if (onCommit) speakOnCommit else speakOnKeyPress,\n+                create = { complete ->\n+                    TextToSpeech(context) { status ->\n+                        callbackHandler.post { complete(status == TextToSpeech.SUCCESS) }\n+                    }\n+                },\n+                onInitialized = { engine, ready ->\n+                    if (ready) speakPending(engine) else pendingSpeech = null\n+                },\n+            )\n+            if (resource == null) {\n+                pendingSpeech = null\n+            } else if (speech.ready === resource) {\n+                speakPending(resource)\n+            }\n+        } catch (e: Exception) {\n+            pendingSpeech = null\n+            Timber.e(e, \"Error on initializing speech feedback\")\n+        }\n+    }\n+\n+    @MainThread\n+    private fun speakPending(engine: TextToSpeech) {\n+        val pending = pendingSpeech ?: return\n+        pendingSpeech = null\n+        if (if (pending.onCommit) speakOnCommit else speakOnKeyPress) {\n+            engine.speak(pending.text, TextToSpeech.QUEUE_FLUSH, null, \"TrimeTTS\")\n+        }\n+    }\n+\n+    @MainThread\n+    private fun prepareSoundPool(): SoundPool? = try {\n+        sounds.acquire(\n+            enabled = applicationContext != null && soundOnKeyPress && soundEffectEnabled && soundVolume > 0,\n+            create = { complete ->\n                 SoundPool.Builder()\n                     .setMaxStreams(3)\n                     .setAudioAttributes(\n                         AudioAttributes.Builder()\n                             .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)\n                             .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)\n                             .build(),\n-                    ).build()\n-        } catch (e: Exception) {\n-            Timber.e(e, \"Error on initializing InputFeedbackManager\")\n-        }\n+                    ).build().also { pool ->\n+                        pool.setOnLoadCompleteListener { loadedPool, soundId, status ->\n+                            callbackHandler.post {\n+                                if (sounds.current === loadedPool && status == 0) readySounds.add(soundId)\n+                            }\n+                        }\n+                        complete(true)\n+                    }\n+            },\n+        )\n+    } catch (e: Exception) {\n+        Timber.e(e, \"Error on initializing sound feedback\")\n+        null\n     }\n \n+    @MainThread\n     private fun cacheSoundId() {\n-        if (!soundEffectEnabled) return\n+        if (!sounds.canAcquire || applicationContext == null || !soundOnKeyPress || !soundEffectEnabled || soundVolume <= 0) return\n \n         if (SoundEffectManager.activeSoundEffect == null) {\n             SoundEffectManager.init()\n@@ -69,9 +142,14 @@ object InputFeedbackManager {\n         if (hash == effectHash) return\n \n         cachedSoundIds.clear()\n+        if (paths.isEmpty()) {\n+            effectHash = hash\n+            return\n+        }\n+        val pool = prepareSoundPool() ?: return\n \n         paths.forEachIndexed { i, path ->\n-            val soundId = loadedSounds.getOrPut(path) { soundPool?.load(path, 1) ?: 0 }\n+            val soundId = loadedSounds.getOrPut(path) { pool.load(path, 1) }\n             if (soundId != 0 && !cachedSoundIds.containsValue(soundId)) {\n                 cachedSoundIds.put(i, soundId)\n             }\n@@ -80,12 +158,15 @@ object InputFeedbackManager {\n         effectHash = hash\n     }\n \n+    @MainThread\n     fun startInput() {\n+        resetSpeechRequests()\n         cacheSoundId()\n     }\n \n+    @MainThread\n     fun reloadSoundEffects() {\n-        effectHash = 0\n+        effectHash = null\n         cacheSoundId()\n     }\n \n@@ -160,14 +241,16 @@ object InputFeedbackManager {\n     /**\n      * Makes a key press sound if the user has this feature enabled in the preferences.\n      */\n+    @MainThread\n     fun keyPressSound(keyCode: Int = 0) {\n         if (!soundOnKeyPress) return\n         if (soundEffectEnabled) {\n             if (soundVolume <= 0) return\n+            if (effectHash == null) cacheSoundId()\n             val volume = soundVolume / 100f\n             val index = querySoundIndex(keyCode)\n             val soundId = cachedSoundIds[index]\n-            soundPool?.play(soundId, volume, volume, 0, 0, 1f)\n+            if (soundId in readySounds) sounds.ready?.play(soundId, volume, volume, 0, 0, 1f)\n         } else {\n             val effect =\n                 when (keyCode) {\n@@ -193,16 +276,20 @@ object InputFeedbackManager {\n     private val speakOnCommit by keyboardPrefs.speakOnCommit\n \n     fun keyPressSpeak(keyCode: Int) {\n-        if (!speakOnKeyPress) return\n-        contentSpeakInternal(keyCode)\n+        speechRequests.dispatch {\n+            if (speakOnKeyPress) contentSpeakInternal(keyCode, onCommit = false)\n+        }\n     }\n \n     fun textCommitSpeak(text: String) {\n-        if (!speakOnCommit) return\n-        contentSpeakInternal(text)\n+        speechRequests.dispatch {\n+            if (speakOnCommit) contentSpeakInternal(text, onCommit = true)\n+        }\n     }\n \n-    private inline fun <reified T> contentSpeakInternal(content: T) {\n+    @MainThread\n+    private inline fun <reified T> contentSpeakInternal(content: T, onCommit: Boolean) {\n+        if (applicationContext == null) return\n         val text =\n             when {\n                 0 is T -> {\n@@ -218,22 +305,26 @@ object InputFeedbackManager {\n                 else -> return\n             }\n \n-        tts?.speak(text, TextToSpeech.QUEUE_FLUSH, null, \"TrimeTTS\")\n+        pendingSpeech = PendingSpeech(text, onCommit)\n+        prepareSpeech(onCommit)\n     }\n \n+    @MainThread\n     fun finishInput() {\n+        resetSpeechRequests()\n         effectPlayProgress = 0\n     }\n \n+    @MainThread\n     fun destroy() {\n-        tts?.stop()\n-        tts?.shutdown()\n-        tts = null\n-        soundPool?.release()\n-        soundPool = null\n+        resetSpeechRequests()\n+        applicationContext = null\n+        speech.destroy()\n+        sounds.destroy()\n \n         loadedSounds.clear()\n+        readySounds.clear()\n         cachedSoundIds.clear()\n-        effectHash = 0\n+        effectHash = null\n     }\n }"},{"sha":"75dca3cb353a7be962dd4dbfab06b8791b4b350d","filename":"app/src/main/java/com/osfans/trime/ime/keyboard/KeyCode.kt","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyCode.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyCode.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyCode.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -13,7 +13,9 @@ import timber.log.Timber\n object KeyCode {\n     // Last-resort Android key-name lookup. It is a platform call that throws\n     // when not mocked, so tests stub it out via the injected function.\n-    internal var androidKeyNameToCode: (String) -> Int = { KeyEvent.keyCodeFromString(\"KEYCODE_$it\") }\n+    internal val defaultAndroidKeyNameToCode: (String) -> Int = { KeyEvent.keyCodeFromString(\"KEYCODE_$it\") }\n+\n+    internal var androidKeyNameToCode: (String) -> Int = defaultAndroidKeyNameToCode\n \n     fun isStandardKey(code: Int): Boolean = code in 1 until RimeKeyMapping.SYMBOL_CODE_OFFSET\n "},{"sha":"8ec02b3349c8f68487ffce6aa130754b67c5b7b2","filename":"app/src/main/java/com/osfans/trime/ime/keyboard/KeyView.kt","status":"modified","additions":2,"deletions":24,"changes":26,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyView.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyView.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyView.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -76,8 +76,7 @@ class KeyView(\n         isSlideCursor = key.click?.isSlideCursor ?: false\n         isSlideDelete = key.click?.isSlideDelete ?: false\n         hasLongPress = key.hasAction(KeyBehavior.LONG_CLICK)\n-        // Shift键始终参与双击检测，以便支持双击锁定大写（可通过设置项 hookShiftLock 关闭）\n-        hasDouble = key.hasAction(KeyBehavior.DOUBLE_CLICK) || key.isShift\n+        hasDouble = key.hasAction(KeyBehavior.DOUBLE_CLICK)\n         hasLazyDouble = key.hasAction(KeyBehavior.LAZY_DOUBLE_CLICK)\n         hasPopup = key.popup.isNotEmpty()\n \n@@ -198,7 +197,7 @@ class KeyView(\n \n         if (action.isModifierKey) {\n             keyboard.clickModifierKey(\n-                modifierKeyLockState(action, behavior),\n+                action.isShiftLock xor (behavior == KeyBehavior.LONG_CLICK),\n                 action.modifierKeyOnMask,\n             )\n             keyboardView.invalidateAllKeys()\n@@ -224,27 +223,6 @@ class KeyView(\n         }\n     }\n \n-    /**\n-     * 计算修饰键本次触发后的锁定状态\n-     *\n-     * - 长按：取[KeyAction.isShiftLock]的反值（沿用原有的 isShiftLock xor longClick 规则）\n-     * - 双击Shift：设置项 hookShiftLock 开启时，锁定大写（CapsLock）；再次单击Shift解除锁定\n-     * - 其它（单击、滑动等）：与[KeyAction.isShiftLock]一致\n-     */\n-    private fun modifierKeyLockState(\n-        action: KeyAction,\n-        behavior: KeyBehavior,\n-    ): Boolean = when (behavior) {\n-        KeyBehavior.LONG_CLICK -> !action.isShiftLock\n-\n-        KeyBehavior.DOUBLE_CLICK ->\n-            // 双击Shift恒等于锁定大写。不能按当前锁定状态取反：默认主题的\n-            // shift_lock: ascii_long 在中文态下单击即锁定，取反会让双击变成解锁。\n-            (keyboardView.hookShiftLock && key.isShift) || action.isShiftLock\n-\n-        else -> action.isShiftLock\n-    }\n-\n     private fun showPopupKeyboard() {\n         val popupKeys = key.popup\n         if (popupKeys.isEmpty()) return"},{"sha":"6543e276575c1b287a89149794786134cbde2eeb","filename":"app/src/main/java/com/osfans/trime/ime/keyboard/KeyboardView.kt","status":"modified","additions":0,"deletions":1,"changes":1,"blob_url":"https://github.com/osfans/trime/blob/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyboardView.kt","raw_url":"https://github.com/osfans/trime/raw/9ff9572f2ed289d8af198f81ce08bdac66d8a69c/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyboardView.kt","contents_url":"https://api.github.com/repos/osfans/trime/contents/app%2Fsrc%2Fmain%2Fjava%2Fcom%2Fosfans%2Ftrime%2Fime%2Fkeyboard%2FKeyboardView.kt?ref=9ff9572f2ed289d8af198f81ce08bdac66d8a69c","patch":"@@ -37,7 +37,6 @@ class KeyboardView(\n     internal val symbolTextSize = theme.style.symbolTextSize.takeIf { it > 0 } ?: keyTextSize\n     internal val popupOnKeyPress by AppPrefs.defaultInstance().keyboard.popupOnKeyPress\n     internal val hookShiftArrow: Boolean by AppPrefs.defaultInstance().keyboard.hookShiftArrow\n-    internal val hookShiftLock: Boolean by AppPrefs.defaultInstance().keyboard.hookShiftLock\n     internal val hideKeySymbol: Boolean by AppPrefs.defaultInstance().keyboard.hideKeySymbol\n     internal val hideKeyHint: Boolean by AppPrefs.defaultInstance().keyboard.hideKeyHint\n "},{"sha":"69cc596f96fcbcc7b5cc9be689d071858b00a32c","filename"