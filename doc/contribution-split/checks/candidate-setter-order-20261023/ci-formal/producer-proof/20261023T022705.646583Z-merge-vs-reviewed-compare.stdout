_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f0f4140d441efc0e013de6f260be5f35806c70d5","url":"https://api.github.com/repos/osfans/trime/commits/f0f4140d441efc0e013de6f260be5f35806c70d5","html_url":"https://github.com/osfans/trime/commit/f0f4140d441efc0e013de6f260be5f35806c70d5"}]},{"sha":"02f0efa8d6a57e4e12bc3e96486152552f5a59c7","node_id":"C_kwDOAivEQNoAKDAyZjBlZmE4ZDZhNTdlNGUxMmJjM2U5NjQ4NjE1MjU1MmY1YTU5Yzc","commit":{"author":{"name":"X2M7","email":"liang.xumin97@gmail.com","date":"2026-10-20T11:48:31Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T11:33:02Z"},"message":"fix: constrain clipboard editor height above action buttons\n\nLet the wrap-content editor respect its existing top and bottom constraints\nwhen vertical space is limited. Keep the action row below the editor and\npreserve the editor's existing internal scrolling and line limits.\n\nRelated: #2170","tree":{"sha":"e1f44625876701afb5f30d994e27f9d9eaf91f2f","url":"https://api.github.com/repos/osfans/trime/git/trees/e1f44625876701afb5f30d994e27f9d9eaf91f2f"},"url":"https://api.github.com/repos/osfans/trime/git/commits/02f0efa8d6a57e4e12bc3e96486152552f5a59c7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/02f0efa8d6a57e4e12bc3e96486152552f5a59c7","html_url":"https://github.com/osfans/trime/commit/02f0efa8d6a57e4e12bc3e96486152552f5a59c7","comments_url":"https://api.github.com/repos/osfans/trime/commits/02f0efa8d6a57e4e12bc3e96486152552f5a59c7/comments","author":{"login":"X2M7","id":239118790,"node_id":"U_kgDODkCpxg","avatar_url":"https://avatars.githubusercontent.com/u/239118790?v=4","gravatar_id":"","url":"https://api.github.com/users/X2M7","html_url":"https://github.com/X2M7","followers_url":"https://api.github.com/users/X2M7/followers","following_url":"https://api.github.com/users/X2M7/following{/other_user}","gists_url":"https://api.github.com/users/X2M7/gists{/gist_id}","starred_url":"https://api.github.com/users/X2M7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/X2M7/subscriptions","organizations_url":"https://api.github.com/users/X2M7/orgs","repos_url":"https://api.github.com/users/X2M7/repos","events_url":"https://api.github.com/users/X2M7/events{/privacy}","received_events_url":"https://api.github.com/users/X2M7/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"87447bd76cd929f1d5db52a1d312a9e3773c992d","url":"https://api.github.com/repos/osfans/trime/commits/87447bd76cd929f1d5db52a1d312a9e3773c992d","html_url":"https://github.com/osfans/trime/commit/87447bd76cd929f1d5db52a1d312a9e3773c992d"}]},{"sha":"b60c329942eefb7ff9d0c6a4c63bde1d333655ad","node_id":"C_kwDOAivEQNoAKGI2MGMzMjk5NDJlZWZiN2ZmOWQwYzZhNGM2M2JkZTFkMzMzNjU1YWQ","commit":{"author":{"name":"X2M7","email":"liang.xumin97@gmail.com","date":"2026-10-20T13:58:09Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T11:33:29Z"},"message":"perf: initialize input feedback resources on demand\n\nAvoid connecting to a speech engine and allocating a custom sound pool when\nfeedback is disabled. Retain the application context and create each backend\nonly when enabled feedback needs it, waiting for initialization before use.\n\nConfine speech requests from Rime jobs to the main thread and invalidate queued\nrequests at input lifecycle boundaries. Reject callbacks from released resources\nand avoid retrying failed initialization on every key press. Cover resource\nownership and worker dispatch with focused regression tests.","tree":{"sha":"76ccdc172659c719787c64eb2bb956f7e1add5a3","url":"https://api.github.com/repos/osfans/trime/git/trees/76ccdc172659c719787c64eb2bb956f7e1add5a3"},"url":"https://api.github.com/repos/osfans/trime/git/commits/b60c329942eefb7ff9d0c6a4c63bde1d333655ad","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/b60c329942eefb7ff9d0c6a4c63bde1d333655ad","html_url":"https://github.com/osfans/trime/commit/b60c329942eefb7ff9d0c6a4c63bde1d333655ad","comments_url":"https://api.github.com/repos/osfans/trime/commits/b60c329942eefb7ff9d0c6a4c63bde1d333655ad/comments","author":{"login":"X2M7","id":239118790,"node_id":"U_kgDODkCpxg","avatar_url":"https://avatars.githubusercontent.com/u/239118790?v=4","gravatar_id":"","url":"https://api.github.com/users/X2M7","html_url":"https://github.com/X2M7","followers_url":"https://api.github.com/users/X2M7/followers","following_url":"https://api.github.com/users/X2M7/following{/other_user}","gists_url":"https://api.github.com/users/X2M7/gists{/gist_id}","starred_url":"https://api.github.com/users/X2M7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/X2M7/subscriptions","organizations_url":"https://api.github.com/users/X2M7/orgs","repos_url":"https://api.github.com/users/X2M7/repos","events_url":"https://api.github.com/users/X2M7/events{/privacy}","received_events_url":"https://api.github.com/users/X2M7/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"02f0efa8d6a57e4e12bc3e96486152552f5a59c7","url":"https://api.github.com/repos/osfans/trime/commits/02f0efa8d6a57e4e12bc3e96486152552f5a59c7","html_url":"https://github.com/osfans/trime/commit/02f0efa8d6a57e4e12bc3e96486152552f5a59c7"}]},{"sha":"a45f6d6536cdd59c61257e994e98d742f9c242ff","node_id":"C_kwDOAivEQNoAKGE0NWY2ZDY1MzZjZGQ1OWM2MTI1N2U5OTRlOThkNzQyZjljMjQyZmY","commit":{"author":{"name":"X2M7","email":"liang.xumin97@gmail.com","date":"2026-10-20T15:29:19Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T11:33:55Z"},"message":"fix: keep Return labels consistent with editor actions\n\nShare the editor action policy between Return dispatch and labels.\nUse the custom action ID when it takes precedence over imeOptions, and fall back\nto the theme default instead of displaying a null app label.\n\nInvalidate cached keyboard keys when the visible Return label changes so an\neditor restart can refresh the current layout. Cover the decision policy and\nreal display-delegate broadcast transitions without changing key event routing.","tree":{"sha":"3369a9b3c4b4eda13c684b2e61319624d3c17cef","url":"https://api.github.com/repos/osfans/trime/git/trees/3369a9b3c4b4eda13c684b2e61319624d3c17cef"},"url":"https://api.github.com/repos/osfans/trime/git/commits/a45f6d6536cdd59c61257e994e98d742f9c242ff","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/a45f6d6536cdd59c61257e994e98d742f9c242ff","html_url":"https://github.com/osfans/trime/commit/a45f6d6536cdd59c61257e994e98d742f9c242ff","comments_url":"https://api.github.com/repos/osfans/trime/commits/a45f6d6536cdd59c61257e994e98d742f9c242ff/comments","author":{"login":"X2M7","id":239118790,"node_id":"U_kgDODkCpxg","avatar_url":"https://avatars.githubusercontent.com/u/239118790?v=4","gravatar_id":"","url":"https://api.github.com/users/X2M7","html_url":"https://github.com/X2M7","followers_url":"https://api.github.com/users/X2M7/followers","following_url":"https://api.github.com/users/X2M7/following{/other_user}","gists_url":"https://api.github.com/users/X2M7/gists{/gist_id}","starred_url":"https://api.github.com/users/X2M7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/X2M7/subscriptions","organizations_url":"https://api.github.com/users/X2M7/orgs","repos_url":"https://api.github.com/users/X2M7/repos","events_url":"https://api.github.com/users/X2M7/events{/privacy}","received_events_url":"https://api.github.com/users/X2M7/re