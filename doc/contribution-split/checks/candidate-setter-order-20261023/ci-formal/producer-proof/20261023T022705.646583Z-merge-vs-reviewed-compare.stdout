5fbceeb6ce","html_url":"https://github.com/osfans/trime/commit/92b13711162c5fa56c701267c3a06e5fbceeb6ce"}]},"merge_base_commit":{"sha":"7f909060a1d42198e749eb1f9a66399f76bf8710","node_id":"C_kwDOAivEQNoAKDdmOTA5MDYwYTFkNDIxOThlNzQ5ZWIxZjlhNjYzOTlmNzZiZjg3MTA","commit":{"author":{"name":"X2M7","email":"liang.xumin97@gmail.com","date":"2026-10-23T02:18:56Z"},"committer":{"name":"X2M7","email":"liang.xumin97@gmail.com","date":"2026-10-23T02:18:56Z"},"message":"fix(ime): call TextView setter before invalidating caches\n\nForward every text and buffer type to TextView before invalidating the custom\nmeasurement and transform caches. Drop the content comparison, which cannot\nrepresent buffer conversions or filtering performed by the parent setter.\nKeep constructor-time calls safe by marking caches dirty without reading them.","tree":{"sha":"2da497746bf3997515b816629ae92e6d2ffef0fb","url":"https://api.github.com/repos/osfans/trime/git/trees/2da497746bf3997515b816629ae92e6d2ffef0fb"},"url":"https://api.github.com/repos/osfans/trime/git/commits/7f909060a1d42198e749eb1f9a66399f76bf8710","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/7f909060a1d42198e749eb1f9a66399f76bf8710","html_url":"https://github.com/osfans/trime/commit/7f909060a1d42198e749eb1f9a66399f76bf8710","comments_url":"https://api.github.com/repos/osfans/trime/commits/7f909060a1d42198e749eb1f9a66399f76bf8710/comments","author":{"login":"X2M7","id":239118790,"node_id":"U_kgDODkCpxg","avatar_url":"https://avatars.githubusercontent.com/u/239118790?v=4","gravatar_id":"","url":"https://api.github.com/users/X2M7","html_url":"https://github.com/X2M7","followers_url":"https://api.github.com/users/X2M7/followers","following_url":"https://api.github.com/users/X2M7/following{/other_user}","gists_url":"https://api.github.com/users/X2M7/gists{/gist_id}","starred_url":"https://api.github.com/users/X2M7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/X2M7/subscriptions","organizations_url":"https://api.github.com/users/X2M7/orgs","repos_url":"https://api.github.com/users/X2M7/repos","events_url":"https://api.github.com/users/X2M7/events{/privacy}","received_events_url":"https://api.github.com/users/X2M7/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"X2M7","id":239118790,"node_id":"U_kgDODkCpxg","avatar_url":"https://avatars.githubusercontent.com/u/239118790?v=4","gravatar_id":"","url":"https://api.github.com/users/X2M7","html_url":"https://github.com/X2M7","followers_url":"https://api.github.com/users/X2M7/followers","following_url":"https://api.github.com/users/X2M7/following{/other_user}","gists_url":"https://api.github.com/users/X2M7/gists{/gist_id}","starred_url":"https://api.github.com/users/X2M7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/X2M7/subscriptions","organizations_url":"https://api.github.com/users/X2M7/orgs","repos_url":"https://api.github.com/users/X2M7/repos","events_url":"https://api.github.com/users/X2M7/events{/privacy}","received_events_url":"https://api.github.com/users/X2M7/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"92b13711162c5fa56c701267c3a06e5fbceeb6ce","url":"https://api.github.com/repos/osfans/trime/commits/92b13711162c5fa56c701267c3a06e5fbceeb6ce","html_url":"https://github.com/osfans/trime/commit/92b13711162c5fa56c701267c3a06e5fbceeb6ce"}]},"status":"ahead","ahead_by":13,"behind_by":0,"total_commits":13,"commits":[{"sha":"f0f4140d441efc0e013de6f260be5f35806c70d5","node_id":"C_kwDOAivEQNoAKGYwZjQxNDBkNDQxZWZjMGUwMTNkZTZmMjYwYmU1ZjM1ODA2YzcwZDU","commit":{"author":{"name":"X2M7","email":"liang.xumin97@gmail.com","date":"2026-10-20T11:48:31Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T11:32:31Z"},"message":"fix: keep setup pages above visible navigation buttons\n\nConstrain the pager to the top of the visible navigation buttons instead of\nletting its content extend behind them. Use a top barrier that ignores gone\nbuttons so the bound follows the Next, Previous and Skip visibility changes.\n\nRelated: #2170","tree":{"sha":"4f26071633fe106d51096ba3b771290505d75d80","url":"https://api.github.com/repos/osfans/trime/git/trees/4f26071633fe106d51096ba3b771290505d75d80"},"url":"https://api.github.com/repos/osfans/trime/git/commits/f0f4140d441efc0e013de6f260be5f35806c70d5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/osfans/trime/commits/f0f4140d441efc0e013de6f260be5f35806c70d5","html_url":"https://github.com/osfans/trime/commit/f0f4140d441efc0e013de6f260be5f35806c70d5","comments_url":"https://api.github.com/repos/osfans/trime/commits/f0f4140d441efc0e013de6f260be5f35806c70d5/comments","author":{"login":"X2M7","id":239118790,"node_id":"U_kgDODkCpxg","avatar_url":"https://avatars.githubusercontent.com/u/239118790?v=4","gravatar_id":"","url":"https://api.github.com/users/X2M7","html_url":"https://github.com/X2M7","followers_url":"https://api.github.com/users/X2M7/followers","following_url":"https://api.github.com/users/X2M7/following{/other_user}","gists_url":"https://api.github.com/users/X2M7/gists{/gist_id}","starred_url":"https://api.github.com/users/X2M7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/X2M7/subscriptions","organizations_url":"https://api.github.com/users/X2M7/orgs","repos_url":"https://api.github.com/users/X2M7/repos","events_url":"https://api.github.com/users/X2M7/events{/privacy}","received_events_url":"https://api.github.com/users/X2M7/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Bambooin","id":7157227,"node_id":"MDQ6VXNlcjcxNTcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/7157227?v=4","gravatar_id":"","url":"https://api.github.com/users/Bambooin","html_url":"https://github.com/Bambooin","followers_url":"https://api.github.com/users/Bambooin/followers","following_url":"https://api.github.com/users/Bambooin/following{/other_user}","gists_url":"https://api.github.com/users/Bambooin/gists{/gist_id}","starred_url":"https://api.github.com/users/Bambooin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bambooin/subscriptions","organizations_url":"https://api.github.com/users/Bambooin/orgs","repos_url":"https://api.github.com/users/Bambooin/repos","events_url":"https://api.github.com/users/Bambooin/events{/privacy}","received_events_url":"https://api.github.com/users/Bambooin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"12ffd16fe03537b6d0ed9716c71cbc33608c2a33","url":"https://api.github.com/repos/osfans/trime/commits/12ffd16fe03537b6d0ed9716c71cbc33608c2a33","html_url":"https://github.com/osfans/trime/commit/12ffd16fe03537b6d0ed9716c71cbc33608c2a33"}]},{"sha":"87447bd76cd929f1d5db52a1d312a9e3773c992d","node_id":"C_kwDOAivEQNoAKDg3NDQ3YmQ3NmNkOTI5ZjFkNWRiNTJhMWQzMTJhOWUzNzczYzk5MmQ","commit":{"author":{"name":"X2M7","email":"liang.xumin97@gmail.com","date":"2026-10-22T00:21:18Z"},"committer":{"name":"Bambooin","email":"ooverflow@outlook.com","date":"2026-10-22T11:32:31Z"},"message":"fix: keep setup content reachable in short viewports\n\nThe footer constraint reduces the page viewport and clips the completed storage hint.\n\nWrap each setup page in a fill-viewport ScrollView so its content remains centered when it\n\nfits and can scroll when it does not. Preserve the existing controls and fixed footer.","tree":{"sha":"d4257e3f0b9f5f1c3139171cc6c99a2de4cdb054","url":"https://api.github.com/repos/osfans/trime/git/trees/d4257e3f0b9f5f1c3139171cc6c99a2de4cdb054"},"url":"https://api.github.com/repos/osfans/trime/git/commits/87447bd76cd929f1d5db52a1d312a9e3773c992d","comme